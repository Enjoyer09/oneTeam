# ==============================================================================
# oneTeam - Environment Variables Configuration
# ==============================================================================

# Supabase Project Credentials
# Found in: Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# PostgreSQL Direct Connection String (for migrations / Prisma / Drizzle)
# Found in: Project Settings -> Database -> Connection string -> URI
DATABASE_URL=postgresql://postgres.your-project-id:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# Telegram Bot Integration (Field Merchandiser shelf upload bot)
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Application Settings
NODE_ENV=development
PORT=3000
