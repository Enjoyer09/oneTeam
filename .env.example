# ==============================================================================
# oneTeam - Environment Variables Configuration
# ==============================================================================
#
# Copy to `.env` and fill in what you need. The API, the panel and the bot all
# run without a database (the API falls back to its in-memory seed), so a bare
# copy of this file is enough for local development.

# ------------------------------------------------------------------------------
# PostgreSQL
# ------------------------------------------------------------------------------
# The only database this project uses. There is no Supabase project, and no code
# reads SUPABASE_* any more — the last client that did was deleted when the bot
# was moved onto the Core API.
#
# Leave it empty to run the API on its in-memory seed data, which is what the
# local demo and the automated tests use.
DATABASE_URL=
# Example, against a local server:
# DATABASE_URL=postgresql://oneteam:password@localhost:5432/oneteam?sslmode=disable

# ------------------------------------------------------------------------------
# Core API
# ------------------------------------------------------------------------------
NODE_ENV=development
# The API reads PORT first, then API_PORT, then falls back to 3001.
PORT=3001

# ------------------------------------------------------------------------------
# Telegram bot
# ------------------------------------------------------------------------------
# Generated by @BotFather. Treat it as a password: anyone holding it controls
# the bot. If it has ever been pasted into a chat or a ticket, rotate it in
# @BotFather and update it here.
TELEGRAM_BOT_TOKEN=

# Where the bot looks for the Core API.
#
# On Railway the bot reaches the API over the private network:
#   ONETEAM_API_URL=http://api.railway.internal:3001
# Locally the default below is used, so this can be left unset.
ONETEAM_API_URL=http://localhost:3001

# The bot's service credential, in the API's `oneteam-user:<userId>` form.
#
# The bot is a server: one process serves every chat, so it holds one service
# token and identifies the acting person by the chat id the update came from.
# It is not a user's token and must not be shared with one.
#
# Keep it out of source control in any real deployment — set it in the platform's
# dashboard so it can be rotated without rebuilding the image.
ONETEAM_API_TOKEN=oneteam-user:usr-admin-001

# ------------------------------------------------------------------------------
# Web panel (standalone tests only)
# ------------------------------------------------------------------------------
# The deployed panel calls /api/ on its own origin and nginx attaches the
# credential, so neither of these is needed in production.
#
# `npm run web:test` runs the panel's data layer directly against the API, with
# no proxy in front of it, so it needs both — VITE_API_BASE_URL here, and the
# same ONETEAM_API_TOKEN set above:
#   VITE_API_BASE_URL=http://localhost:3001 npm run web:test
VITE_API_BASE_URL=
