# ==============================================================================
# oneTeam - Environment Variables Configuration
# ==============================================================================
#
# Copy to `.env` and fill in what you need. The API, the panel and the bot all
# run without a database (the API falls back to its in-memory seed), so a bare
# copy of this file is enough for local development.

# ------------------------------------------------------------------------------
# PostgreSQL
# ------------------------------------------------------------------------------
# The only database this project uses. There is no Supabase project, and no code
# reads SUPABASE_* any more — the last client that did was deleted when the bot
# was moved onto the Core API.
#
# Leave it empty to run the API on its in-memory seed data, which is what the
# local demo and the automated tests use.
DATABASE_URL=
# Example, against a local server:
# DATABASE_URL=postgresql://oneteam:password@localhost:5432/oneteam?sslmode=disable

# ------------------------------------------------------------------------------
# Photo storage (S3-compatible: Cloudflare R2 in production)
# ------------------------------------------------------------------------------
# Shelf photos are the only large object this platform stores. Where they live is
# chosen by ONE variable, and the two settings are not equivalent:
#
#   STORAGE_DRIVER=inline  photos go into the Postgres row as base64 data URLs
#   STORAGE_DRIVER=s3      photos go to a bucket; the API returns a presigned URL
#
# THIS IS NOT A COSMETIC CHOICE. `inline` keeps every audit photo in the database
# row itself, which inflates table and WAL size, makes every read of a task pull
# megabytes, and cannot be served from a CDN. Production runs `s3` (Railway sets
# it, and GET /api/health reports the active driver under `photoStorage` — check
# that endpoint before believing photos are in a bucket).
#
# With `s3` set, all three of S3_BUCKET, S3_ACCESS_KEY_ID and S3_SECRET_ACCESS_KEY
# are REQUIRED. If any is missing the API refuses to guess: it logs
# "⛔ [STORAGE] ... falling back to inline storage" and keeps writing photos into
# the database. That degradation is deliberate — a half-configured bucket that
# silently succeeded would be worse — but it means a typo here does not fail
# loudly at boot, so verify with /api/health rather than with a deploy log.
STORAGE_DRIVER=

# Cloudflare R2 values. For R2, S3_ENDPOINT is the account endpoint and
# S3_FORCE_PATH_STYLE is 1, because R2 does not support virtual-host buckets.
#   S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=1
# Public base URL that presigned upload redirects resolve against.
S3_PUBLIC_BASE_URL=
# How long a presigned upload URL stays valid, in seconds. Default 900.
S3_PRESIGN_EXPIRY_SECONDS=

# ------------------------------------------------------------------------------
# Core API
# ------------------------------------------------------------------------------
NODE_ENV=development
# The API reads PORT first, then API_PORT, then falls back to 3001.
PORT=3001

# Auto-apply db/api-schema.sql and db/migrations/*.sql on boot. Keep true on a
# single-writer deployment; see the in-memory replica note below before running
# more than one replica with it on.
ONETEAM_AUTO_MIGRATE=

# The first admin panel key, minted on boot when no panel token exists yet. The
# user it authenticates as is ONETEAM_PANEL_BOOTSTRAP_USER. Treat it as a
# one-shot: sign in, create a real key through the panel, then unset this.
ONETEAM_PANEL_BOOTSTRAP_KEY=

# How often the bot sweeps for expired/timed-out tasks, in ms.
ONETEAM_BOT_SWEEP_MS=

# How often a replica re-reads the change counter to notice writes made by
# another instance. This is the bound on how stale a second replica can be, so
# it is also the real answer to "how stale can a read get". Default 1000ms.
ONETEAM_REFRESH_MS=

# ------------------------------------------------------------------------------
# Telegram bot
# ------------------------------------------------------------------------------
# Generated by @BotFather. Treat it as a password: anyone holding it controls
# the bot. If it has ever been pasted into a chat or a ticket, rotate it in
# @BotFather and update it here.
TELEGRAM_BOT_TOKEN=

# Where the bot looks for the Core API.
#
# On Railway the bot reaches the API over the private network:
#   ONETEAM_API_URL=http://api.railway.internal:3001
# Locally the default below is used, so this can be left unset.
ONETEAM_API_URL=http://localhost:3001

# The bot's service credential, in the API's `oneteam-user:<userId>` form.
#
# The bot is a server: one process serves every chat, so it holds one service
# token and identifies the acting person by the chat id the update came from.
# It is not a user's token and must not be shared with one.
#
# Keep it out of source control in any real deployment — set it in the platform's
# dashboard so it can be rotated without rebuilding the image.
#
# NOTE: this legacy `oneteam-user:<userId>` form is unsigned and never expires.
# In production, configure ONETEAM_SERVICE_SIGNING_SECRET below instead — the bot
# then mints short-lived signed tokens from ONETEAM_SERVICE_USER_ID and this
# static token is no longer needed.
ONETEAM_API_TOKEN=oneteam-user:usr-admin-001

# ------------------------------------------------------------------------------
# Service credential signing (security — set these in production)
# ------------------------------------------------------------------------------
# The service credential names the user a server acts as, and it can name ANY
# user. Unsigned it is game-over if leaked (replayable forever); signed it
# expires in minutes. Setting the signing secret is the single switch that
# closes the unsigned hole — see packages/types/src/service-credential.ts.
#
# The HMAC key shared by the bot (mints) and the API (verifies). Generate a long
# random value, e.g. `openssl rand -hex 32`, and set the SAME value on both.
# When set, the API rejects unsigned legacy tokens unless the escape hatch below
# is explicitly enabled.
ONETEAM_SERVICE_SIGNING_SECRET=

# The user the bot's own signed credential names. Falls back to the id parsed
# from ONETEAM_API_TOKEN when unset; there is deliberately no admin default.
ONETEAM_SERVICE_USER_ID=

# Temporary rollout escape hatch: set to `true` to keep honouring unsigned
# legacy tokens even after a signing secret is configured. Leave unset (the
# default is to refuse them) once every caller mints signed tokens.
ONETEAM_ALLOW_LEGACY_SERVICE_TOKEN=

# ------------------------------------------------------------------------------
# Other production security controls (fail closed when unset in production)
# ------------------------------------------------------------------------------
# Browser origins allowed to call the API, comma-separated and exact. A wildcard
# is refused. Unset in production means NO cross-origin request is allowed (the
# API logs this loudly rather than silently allowing everything). See main.ts.
#   CORS_ALLOWED_ORIGINS=https://portal.oneteam.az,https://admin.oneteam.az
CORS_ALLOWED_ORIGINS=

# Shared secret Telegram sends back in the X-Telegram-Bot-Api-Secret-Token
# header. In production the webhook fails closed (503) when this is unset rather
# than accept unverified state changes. Register it with setWebhook.
TELEGRAM_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# Service credential signing (IMPERATIVE IN PRODUCTION)
# ------------------------------------------------------------------------------
# Machines (the bot, the mobile app, scripts) authenticate with a service
# credential: `oneteam-user:<userId>`. When this secret is set, callers must also
# mint a short-lived signed token via signServiceCredential (packages/types), so a
# leaked prefix alone is useless and a captured token expires on its own.
#
# WHEN THIS IS UNSET THE API ACCEPTS ANY UNSIGNED CREDENTIAL. It does not refuse;
# it logs one warning per request and moves on:
#
#   ⚠️ [AuthGuard] An unsigned service credential was accepted. Set
#   ONETEAM_SERVICE_SIGNING_SECRET and have callers mint signed, expiring tokens
#
# That warning in the production log means every caller is currently presenting a
# bearer string that never expires and was never signed. This is the single
# highest-value secret to set on this deployment: it converts "anyone who learns
# the format can act as any user, indefinitely" into "only holders of the signing
# key, and only for minutes".
#
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Then mint with: signServiceCredential('usr-admin-001', process.env.ONETEAM_SERVICE_SIGNING_SECRET)
ONETEAM_SERVICE_SIGNING_SECRET=

# Escape hatch for the pre-signing world. While true, an unsigned credential is
# accepted even in production — do this only to unblock a rollout, and note that
# setting it re-opens the hole the signing secret closes.
ONETEAM_ALLOW_LEGACY_SERVICE_TOKEN=

# The user an admin panel key authenticates as when no explicit user is given.
# Changing it changes who the panel acts as, so it is documented rather than
# guessed; the default is usr-admin-001.
ONETEAM_PANEL_BOOTSTRAP_USER=

# ------------------------------------------------------------------------------
# Limits and tuning (all optional; defaults are the values shown)
# ------------------------------------------------------------------------------
# Device enrolment abuse limits. A leaked store code is the only thing standing
# between an outsider and a field identity, so both of these are rate limits on
# how fast that code can be turned into devices.
#   ONETEAM_ENROLLMENT_MAX_FAILURES   failed attempts per window (default 20)
#   ONETEAM_ENROLLMENT_MAX_NEW_DEVICES new devices per store (default 30)
ONETEAM_ENROLLMENT_MAX_FAILURES=
ONETEAM_ENROLLMENT_MAX_NEW_DEVICES=

# Notification scheduler cadence. 15-minute reminders are computed by sweeping
# for tasks approaching their deadline, so these bound how late a reminder can be.
ONETEAM_NOTIFY_SWEEP_MS=
ONETEAM_NOTIFY_POLL_MS=

# Telegram bot conversation state lifetime, in seconds. A half-finished
# checklist older than this is dropped rather than resumed hours later.
ONETEAM_BOT_SESSION_TTL_SECONDS=

# Wall-clock ceiling on one YOLO inference. A hung detector should fail the audit
# into human review, not hold the submission open.
ONETEAM_YOLO_TIMEOUT_MS=

# Optional second factor for device enrolment: when set, a device must present
# it to mint a token, so a leaked store code alone cannot enrol an identity.
ONETEAM_ENROLLMENT_SECRET=

# ------------------------------------------------------------------------------
# Shelf-photo vision (OFF by default — a deliberate default, not an oversight)
# ------------------------------------------------------------------------------
# Production does not judge shelf photos today. Without a provider set, the score a
# supervisor acts on comes from the rule-based auto-approve path (geolocation,
# checklist completeness, before/after) and nothing here runs. Turning vision on is
# setting ONETEAM_VISION_PROVIDER — there is no code change and no default that
# quietly starts judging photos.
#
# EXTERNAL-CALL WARNING — 'vision-llm' and 'hybrid' send the shelf photo to a
# third party. A shelf photo can carry commercial data and incidental PII (a
# bystander, a price label, a reflection). Choosing one is a data-handling
# decision, and the provider+model is recorded on every result so the audit trail
# shows which model saw what. Free/community models also log prompts by default.
#   off | simulation | yolo | vision-llm | hybrid
ONETEAM_VISION_PROVIDER=off

# --- Path A: any OpenAI-compatible endpoint (Anthropic compat, a gateway, ...) ---
# All three are required. A half-configured client is treated as no client, so the
# hybrid escalates to a clean "no LLM" path instead of an error.
ONETEAM_VISION_LLM_URL=
ONETEAM_VISION_LLM_MODEL=
ONETEAM_VISION_LLM_KEY=
# Per-call ceiling in ms. Default 20000. A hung model must escalate the submission
# to a human rather than stall the bot's photo handler forever.
ONETEAM_VISION_LLM_TIMEOUT_MS=
# Label recorded on each result for the audit trail.
ONETEAM_VISION_LLM_LABEL=

# --- Path B: OpenRouter (used when no *_LLM_* endpoint is set) ---
# The client rate-limits itself to 20 req/min and retries ONLY a 429; every other
# status throws immediately, because retrying a 401 or a spent balance would just
# delay the same failure. Both values are required.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Dashboard attribution headers OpenRouter expects.
OPENROUTER_REFERER=
OPENROUTER_TITLE=oneTeam
OPENROUTER_TIMEOUT_MS=

# How confident YOLO must be, on its own, for 'hybrid' to skip the LLM entirely.
# 0-1; default 0.55. Lower spends more on the LLM, higher trusts the detector more.
ONETEAM_YOLO_CONFIDENCE_FLOOR=

# ------------------------------------------------------------------------------
# Web panel (standalone tests only)
# ------------------------------------------------------------------------------
# The deployed panel calls /api/ on its own origin and nginx attaches the
# credential, so neither of these is needed in production.
#
# `npm run web:test` runs the panel's data layer directly against the API, with
# no proxy in front of it, so it needs both — VITE_API_BASE_URL here, and the
# same ONETEAM_API_TOKEN set above:
#   VITE_API_BASE_URL=http://localhost:3001 npm run web:test
VITE_API_BASE_URL=
