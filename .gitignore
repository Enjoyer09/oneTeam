# =============================================================================
#  oneTeam — .gitignore
# =============================================================================
#  WHY THIS FILE EXISTS
#  This project previously had NO .gitignore. Because the git repository root
#  sat at the user's home directory, everything became committable — including
#  ~/.ssh private keys and service tokens. This file is the first line of
#  defence. Treat it as security infrastructure, not housekeeping.
#
#  RULE: never add an exception here for a file that can hold a credential.
# =============================================================================

# ---- Secrets & environment ------------------------------------------------
# Committed .env files are the single most common cause of credential leaks.
# Only *.example templates may be committed; they must contain placeholders.
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
!*.pub
credentials.json
service-account*.json
.secrets/
secrets/

# ---- Dependencies ---------------------------------------------------------
node_modules/
.pnpm-store/
.yarn/
.yarn-cache/
jspm_packages/

# ---- Build output ---------------------------------------------------------
# Build artefacts are reproducible. Committing them creates merge conflicts
# and hides whether a build actually succeeded from a clean checkout.
dist/
build/
out/
*.tsbuildinfo
.next/
.turbo/
.vite/
web/dist/
apps/*/dist/
packages/*/dist/
mobile/build/

# ---- Test & coverage ------------------------------------------------------
coverage/
.nyc_output/
*.lcov
junit.xml
test-results/
playwright-report/

# ---- Python ---------------------------------------------------------------
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- Machine-learning artefacts -------------------------------------------
# Model weights are large binaries. They belong in object storage or Git LFS,
# never in a normal git history.
*.pt
*.pth
*.onnx
*.h5
*.safetensors
*.ckpt
yolov8*.pt

# ---- Editor & OS ----------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
*.swp
*.swo
*~
.idea/
*.iml
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json

# ---- Logs -----------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/
*.pid
*.seed

# ---- Local scratch / review artefacts ------------------------------------
# Screenshot output from the UI verification harnesses is regenerated on
# demand and would otherwise add thousands of binary files to history.
ui-audit/shots/
ui-audit/report-img/
ui-design/shots/
ui-glass/shots/
ui-glass/shots-app/
*-shots/
.workbuddy-ai/
.claude/
.gemini/
.codex/

# ---- Docker / local infrastructure ---------------------------------------
*.sqlite
*.sqlite3
*.db
docker-compose.override.yml

# ---- Temporary ------------------------------------------------------------
tmp/
temp/
.tmp/
*.bak
*.orig
*.rej
