{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    // "DOM" is in Expo's own default tsconfig, and it is not decoration: without
    // it `AbortSignal.timeout` has no type, because that static lives in the DOM
    // lib rather than in ES2022 or in @types/node. The app calls it in
    // portalApi.ts to bound every request, so this is a real dependency, not a
    // convenience. It only reappeared once `mobile/node_modules` existed —
    // before that the type silently resolved somewhere else.
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",

    // WHY THESE PATHS EXIST — CI CAUGHT THIS, A LOCAL RUN COULD NOT
    // -------------------------------------------------------------
    // `src/types/index.ts` imports `@oneteam/types`. Without a mapping, that
    // resolves through `node_modules/@oneteam/types`, which is a SYMLINK to
    // `packages/types` — and that package's `types` field points at
    // `./dist/index.d.ts`, which is GITIGNORED.
    //
    // So the type check silently depended on a build artefact that CI never
    // builds. It passed on every developer machine, where `dist/` existed from
    // an earlier `npm run build`, and failed on the first clean checkout with
    // `Cannot find module '@oneteam/types'`.
    //
    // The root `tsconfig.json` already solves this the same way, mapping both
    // `@oneteam/types` and `@oneteam/database` to `packages/*/src`. This is that
    // same rule, for the same reason: type-check against SOURCE, so the result
    // does not depend on whether somebody remembered to build.
    "baseUrl": ".",
    "paths": {
      "@oneteam/types": ["../packages/types/src"]
    }
  },
  "include": ["src/**/*"]
  // The native dependencies are installed in the mobile workspace, so adapters
  // and screens that use them belong in the same type-check as the rest of the
  // app. Keeping an exclusion here would hide real integration errors.
}
