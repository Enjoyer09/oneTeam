{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "baseUrl": ".",
    "paths": {
      "@oneteam/types": ["packages/types/src"],
      "@oneteam/types/dist/service-credential": ["packages/types/src/service-credential.ts"],
      "@oneteam/database": ["packages/database/src"]
    }
  },
  "include": ["src/**/*", "packages/**/*", "apps/**/*"],
  "exclude": ["node_modules", "dist"]
}
