{
  "name": "oneteam-platform",
  "version": "0.1.0",
  "description": "Retail shelf monitoring platform for FMCG (Coca-Cola distribution)",
  "private": true,
  "main": "dist/bot/index.js",
  "scripts": {
    "start": "node scripts/start-all.mjs",
    "start:all": "node scripts/start-all.mjs",
    "build": "node ./node_modules/typescript/bin/tsc --build packages/types/tsconfig.json packages/database/tsconfig.json && node ./node_modules/typescript/bin/tsc --project apps/api/tsconfig.json && node ./web/node_modules/typescript/bin/tsc --project web/tsconfig.json && node ./web/node_modules/vite/bin/vite.js build web",
    "build:packages": "node ./node_modules/typescript/bin/tsc --build packages/types/tsconfig.json packages/database/tsconfig.json",
    "bot": "tsx src/bot/index.ts",
    "bot:test": "node ./node_modules/tsx/dist/cli.mjs src/bot/test-runner.ts",
    "web:build": "node ./web/node_modules/typescript/bin/tsc --project web/tsconfig.json && node ./web/node_modules/vite/bin/vite.js build web",
    "web:dev": "node ./web/node_modules/vite/bin/vite.js web",
    "web:test": "VITE_API_BASE_URL=http://localhost:3001 ONETEAM_API_TOKEN=oneteam-user:usr-admin-001 node ./node_modules/tsx/dist/cli.mjs web/src/smoke-test.ts",
    "mobile:test": "node ./node_modules/tsx/dist/cli.mjs mobile/src/tests/mobile-test-runner.ts",
    "test:credentials": "node ./node_modules/tsx/dist/cli.mjs mobile/src/services/credentialStore.test.ts",
    "test:queue": "node ./node_modules/tsx/dist/cli.mjs mobile/src/services/offlineQueue.test.ts",
    "test:secrets": "node scripts/quality/secret-scan.test.mjs",
    "test:break": "node scripts/dev/break-detector-queue.mjs",
    "test:break:device-revoke": "node scripts/dev/break-detector-device-revoke.mjs",
    "test:break:credentials": "node scripts/dev/break-detector-credentials.mjs",
    "mobile:check": "node ./node_modules/typescript/bin/tsc --project mobile/tsconfig.json --noEmit",
    "mobile:config": "node scripts/dev/verify-mobile-config.mjs",
    "mobile:assets": "python3 scripts/dev/make-mobile-assets.py",
    "api:start": "node apps/api/dist/main.js",
    "api:build": "node ./node_modules/typescript/bin/tsc --build apps/api/tsconfig.json",
    "api:dev": "npm run api:build && node apps/api/dist/main.js",
    "test:core": "node ./node_modules/tsx/dist/cli.mjs apps/api/test/integration.spec.ts",
    "test:phase2": "node ./node_modules/tsx/dist/cli.mjs apps/api/test/phase2.spec.ts",
    "test:storage": "node ./node_modules/tsx/dist/cli.mjs apps/api/test/storage.spec.ts",
    "test:device": "node ./node_modules/tsx/dist/cli.mjs apps/api/test/device-credential.spec.ts",
    "test:device-revoke": "node ./node_modules/tsx/dist/cli.mjs apps/api/test/device-revoke.spec.ts",
    "test:replica": "node ./node_modules/tsx/dist/cli.mjs apps/api/test/replica-sync.spec.ts",
    "test:panel": "node ./node_modules/tsx/dist/cli.mjs apps/api/test/panel-auth.spec.ts",
    "test:stores": "node ./node_modules/tsx/dist/cli.mjs apps/api/test/store-crud.spec.ts",
    "test:tasks": "node ./node_modules/tsx/dist/cli.mjs apps/api/test/task-crud.spec.ts",
    "test:roles": "node ./node_modules/tsx/dist/cli.mjs apps/api/test/roles.spec.ts",
    "test:flow": "node ./node_modules/tsx/dist/cli.mjs apps/api/test/bot-session.spec.ts",
    "test:notify": "ONETEAM_API_URL=http://127.0.0.1:3141 ONETEAM_API_TOKEN=oneteam-user:usr-admin-001 node ./node_modules/tsx/dist/cli.mjs apps/api/test/notifications.spec.ts",
    "test:bot-storage": "node ./node_modules/tsx/dist/cli.mjs src/bot/sessionStorage.test.ts",
    "test:router": "node ./node_modules/tsx/dist/cli.mjs src/bot/router.test.ts",
    "test:ai": "node ./node_modules/tsx/dist/cli.mjs src/services/aiVision.test.ts",
    "test:all": "npm run test:secrets && npm run test:core && npm run test:phase2 && npm run test:storage && npm run test:ai && npm run test:credentials && npm run test:queue",
    "test:live": "npm run test:panel && npm run test:stores && npm run test:tasks && npm run test:roles && npm run test:device && npm run test:device-revoke && npm run test:replica && npm run test:flow && npm run test:notify && npm run test:router && npm run bot:test && npm run web:test && npm run mobile:test",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:strict": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "secrets:scan": "node scripts/quality/secret-scan.mjs",
    "quality": "npm run format:check && npm run mobile:config && npm run mobile:check && npm run lint && npm run type-check && npm run test:all",
    "mobile:test:write": "ONETEAM_MOBILE_WRITES=1 node ./node_modules/tsx/dist/cli.mjs mobile/src/tests/mobile-test-runner.ts"
  },
  "keywords": [
    "retail",
    "fmcg",
    "shelf-monitoring",
    "planogram",
    "coca-cola",
    "telegram-bot",
    "supabase"
  ],
  "author": "oneTeam Core Team",
  "license": "UNLICENSED",
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "dotenv": "^16.4.7",
    "grammy": "^1.35.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@prisma/client": "^7.10.0",
    "@types/node": "^22.13.9",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "prisma": "^7.10.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.70.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
