{
  "name": "oneteam-platform",
  "version": "0.1.0",
  "description": "Retail shelf monitoring platform for FMCG (Coca-Cola distribution)",
  "private": true,
  "main": "dist/bot/index.js",
  "scripts": {
    "start": "node scripts/start-all.mjs",
    "start:all": "node scripts/start-all.mjs",
    "build": "node ./node_modules/typescript/bin/tsc --build packages/types/tsconfig.json packages/database/tsconfig.json && node ./node_modules/typescript/bin/tsc --project apps/api/tsconfig.json && node ./web/node_modules/typescript/bin/tsc --project web/tsconfig.json && node ./web/node_modules/vite/bin/vite.js build web",
    "build:packages": "node ./node_modules/typescript/bin/tsc --build packages/types/tsconfig.json packages/database/tsconfig.json",
    "bot": "tsx src/bot/index.ts",
    "bot:test": "node ./node_modules/tsx/dist/cli.mjs src/bot/test-runner.ts",
    "web:build": "node ./web/node_modules/typescript/bin/tsc --project web/tsconfig.json && node ./web/node_modules/vite/bin/vite.js build web",
    "web:check": "node ./web/node_modules/typescript/bin/tsc --project web/tsconfig.json",
    "web:dev": "node ./web/node_modules/vite/bin/vite.js web",
    "web:test": "VITE_API_BASE_URL=$ONETEAM_API_URL ONETEAM_API_TOKEN=oneteam-user:usr-admin-001 node ./node_modules/tsx/dist/cli.mjs web/src/smoke-test.ts",
    "mobile:test": "node ./node_modules/tsx/dist/cli.mjs mobile/src/tests/mobile-test-runner.ts",
    "test:credentials": "node ./node_modules/tsx/dist/cli.mjs --import ./scripts/test-credential.mjs mobile/src/services/credentialStore.test.ts",
    "test:queue": "node ./node_modules/tsx/dist/cli.mjs --import ./scripts/test-credential.mjs mobile/src/services/offlineQueue.test.ts",
    "test:sync-message": "node ./node_modules/tsx/dist/cli.mjs mobile/src/tests/syncMessage.test.ts",
    "test:capture": "node ./node_modules/tsx/dist/cli.mjs mobile/src/tests/capture-truth.test.ts",
    "test:photo-quality": "node ./node_modules/tsx/dist/cli.mjs mobile/src/utils/photoQuality.test.ts",
    "test:photo-upload": "node ./node_modules/tsx/dist/cli.mjs --import ./scripts/test-credential.mjs mobile/src/services/photoUpload.test.ts",
    "test:verdict": "node ./node_modules/tsx/dist/cli.mjs --import ./scripts/test-credential.mjs src/services/vision/verdict.test.ts",
    "test:roi": "node ./node_modules/tsx/dist/cli.mjs --import ./scripts/test-credential.mjs src/services/vision/roi.test.ts",
    "test:portal-silent-success": "node scripts/quality/portal-silent-success.test.mjs",
    "test:auth-coverage": "node scripts/quality/auth-guard-coverage.test.mjs",
    "test:labels": "node scripts/quality/label-association.test.mjs",
    "test:web": "npm --prefix web run test",
    "smoke:prod": "node scripts/ops/prod-smoke.mjs",
    "test:secrets": "node scripts/quality/secret-scan.test.mjs",
    "test:break": "node scripts/dev/break-detector-queue.mjs",
    "test:break:device-revoke": "node scripts/dev/break-detector-device-revoke.mjs",
    "test:break:credentials": "node scripts/dev/break-detector-credentials.mjs",
    "mobile:check": "node ./node_modules/typescript/bin/tsc --project mobile/tsconfig.json --noEmit",
    "mobile:config": "node scripts/dev/verify-mobile-config.mjs",
    "mobile:ios": "bash scripts/dev/run-on-device.sh",
    "mobile:ios:prod": "ONETEAM_MOBILE_API_URL=https://api-production-c17b.up.railway.app bash scripts/dev/run-on-device.sh",
    "test:dev-plugin": "node scripts/dev/verify-dev-servers-plugin.mjs",
    "test:dev-survive": "node scripts/dev/verify-dev-servers-survive.mjs",
    "demo:accounts": "node scripts/dev/demo-accounts.mjs",
    "test:ui-ids": "node scripts/quality/ui-test-ids.mjs && node scripts/quality/ui-test-ids.mjs --self-test",
    "mobile:assets": "python3 scripts/dev/make-mobile-assets.py",
    "api:start": "node apps/api/dist/main.js",
    "api:build": "node ./node_modules/typescript/bin/tsc --build apps/api/tsconfig.json",
    "api:dev": "npm run api:build && node apps/api/dist/main.js",
    "test:core": "node ./node_modules/tsx/dist/cli.mjs apps/api/test/integration.spec.ts",
    "test:phase2": "node ./node_modules/tsx/dist/cli.mjs apps/api/test/phase2.spec.ts",
    "test:storage": "node ./node_modules/tsx/dist/cli.mjs apps/api/test/storage.spec.ts",
    "test:device": "node ./node_modules/tsx/dist/cli.mjs apps/api/test/device-credential.spec.ts",
    "test:device-revoke": "node ./node_modules/tsx/dist/cli.mjs apps/api/test/device-revoke.spec.ts",
    "test:device-block": "node ./node_modules/tsx/dist/cli.mjs apps/api/test/device-block.spec.ts",
    "test:replica": "node ./node_modules/tsx/dist/cli.mjs apps/api/test/replica-sync.spec.ts",
    "test:refresh": "node ./node_modules/tsx/dist/cli.mjs apps/api/test/refresh-defer.spec.ts",
    "test:write-order": "node ./node_modules/tsx/dist/cli.mjs apps/api/test/write-order.spec.ts",
    "test:panel": "node ./node_modules/tsx/dist/cli.mjs apps/api/test/panel-auth.spec.ts",
    "test:stores": "node ./node_modules/tsx/dist/cli.mjs apps/api/test/store-crud.spec.ts",
    "test:products": "node ./node_modules/tsx/dist/cli.mjs apps/api/test/product-crud.spec.ts",
    "test:shelf": "node ./node_modules/tsx/dist/cli.mjs apps/api/test/shelf-crud.spec.ts",
    "test:shelf-count": "node ./node_modules/tsx/dist/cli.mjs apps/api/test/shelf-count.spec.ts",
    "test:tasks": "node ./node_modules/tsx/dist/cli.mjs apps/api/test/task-crud.spec.ts",
    "test:roles": "node ./node_modules/tsx/dist/cli.mjs apps/api/test/roles.spec.ts",
    "test:flow": "node ./node_modules/tsx/dist/cli.mjs apps/api/test/bot-session.spec.ts",
    "test:notify": "ONETEAM_API_URL=http://127.0.0.1:3141 ONETEAM_API_TOKEN=oneteam-user:usr-admin-001 node ./node_modules/tsx/dist/cli.mjs apps/api/test/notifications.spec.ts",
    "test:bot-storage": "node ./node_modules/tsx/dist/cli.mjs --import ./scripts/test-credential.mjs src/bot/sessionStorage.test.ts",
    "test:router": "node ./node_modules/tsx/dist/cli.mjs --import ./scripts/test-credential.mjs src/bot/router.test.ts",
    "test:ai": "node ./node_modules/tsx/dist/cli.mjs --import ./scripts/test-credential.mjs src/services/aiVision.test.ts",
    "test:vision": "node ./node_modules/tsx/dist/cli.mjs --import ./scripts/test-credential.mjs src/services/vision/vision.test.ts",
    "test:vision-worker": "python3 vision-worker/test_server.py",
    "test:openrouter": "node ./node_modules/tsx/dist/cli.mjs --import ./scripts/test-credential.mjs src/services/vision/openrouter.test.ts",
    "test:bot-picker": "node ./node_modules/tsx/dist/cli.mjs --import ./scripts/test-credential.mjs src/bot/handlers/submission.picker.test.ts",
    "test:today": "node ./node_modules/tsx/dist/cli.mjs --import ./scripts/test-credential.mjs src/bot/handlers/today.test.ts",
    "test:commands": "node ./node_modules/tsx/dist/cli.mjs --import ./scripts/test-credential.mjs src/bot/commands.test.ts",
    "test:checklist-type": "node ./node_modules/tsx/dist/cli.mjs --import ./scripts/test-credential.mjs src/bot/handlers/taskFlow.checklist.test.ts",
    "test:markdown-escape": "node ./node_modules/tsx/dist/cli.mjs --import ./scripts/test-credential.mjs src/bot/handlers/tasks.markdown.test.ts",
    "test:start-throttle": "node ./node_modules/tsx/dist/cli.mjs --import ./scripts/test-credential.mjs src/bot/handlers/start.throttle.test.ts",
    "test:group-guard": "node ./node_modules/tsx/dist/cli.mjs --import ./scripts/test-credential.mjs src/bot/group-guard.test.ts",
    "test:reclaim-on-open": "node ./node_modules/tsx/dist/cli.mjs --import ./scripts/test-credential.mjs src/bot/handlers/tasks.reclaim.test.ts",
    "test:deeplink": "node ./node_modules/tsx/dist/cli.mjs --import ./scripts/test-credential.mjs src/bot/handlers/start.deeplink.test.ts",
    "test:signing": "node ./node_modules/tsx/dist/cli.mjs packages/types/src/service-credential.test.ts",
    "test:ux": "node ./node_modules/tsx/dist/cli.mjs --import ./scripts/test-credential.mjs mobile/src/tests/ux-flow.test.ts && node ./node_modules/tsx/dist/cli.mjs --import ./scripts/test-credential.mjs src/bot/handlers/tasks.switch.test.ts && node ./node_modules/tsx/dist/cli.mjs --import ./scripts/test-credential.mjs src/bot/handlers/tasks.pagination.test.ts",
    "test:all": "npm run test:ux && npm run test:secrets && npm run test:portal-silent-success && npm run test:auth-coverage && npm run test:labels && npm run test:web && npm run test:core && npm run test:device-block-auth && npm run test:ai-verdict-scope && npm run test:phase2 && npm run test:storage && npm run test:photo-provenance && npm run test:ai && npm run test:vision && npm run test:openrouter && npm run test:verdict && npm run test:roi && npm run test:bot-picker && npm run test:today && npm run test:commands && npm run test:checklist-type && npm run test:markdown-escape && npm run test:start-throttle && npm run test:group-guard && npm run test:reclaim-on-open && npm run test:deeplink && npm run test:signing && npm run test:credentials && npm run test:queue && npm run test:sync-message && npm run test:photo-quality && npm run test:photo-upload && npm run test:capture && npm run test:db-backup && npm run test:gps-freshness && npm run test:vision-worker",
    "test:live": "npm run build:packages && npm run api:build && node scripts/quality/run-live-suites.mjs",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:strict": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "secrets:scan": "node scripts/quality/secret-scan.mjs",
    "quality": "npm run format:check && npm run mobile:config && npm run test:ui-ids && npm run mobile:check && npm run lint && npm run type-check && npm run test:all",
    "gate:fast": "node scripts/quality/local-gate.mjs --fast",
    "gate": "node scripts/quality/local-gate.mjs",
    "gate:install": "git config core.hooksPath .githooks",
    "mobile:test:write": "ONETEAM_MOBILE_WRITES=1 node ./node_modules/tsx/dist/cli.mjs mobile/src/tests/mobile-test-runner.ts",
    "test:device-block-auth": "node ./node_modules/tsx/dist/cli.mjs --import ./scripts/test-credential.mjs apps/api/test/device-block-auth.spec.ts",
    "test:ai-verdict-scope": "node ./node_modules/tsx/dist/cli.mjs apps/api/test/ai-verdict-scope.spec.ts",
    "test:photo-provenance": "node ./node_modules/tsx/dist/cli.mjs --import ./scripts/test-credential.mjs apps/api/test/photo-provenance.spec.ts",
    "test:db-backup": "bash scripts/ops/db-backup.test.sh",
    "test:live:suites": "node scripts/quality/run-live-suites.mjs",
    "live:local": "bash scripts/quality/local-live-tests.sh",
    "test:gps-freshness": "node ./node_modules/tsx/dist/cli.mjs apps/api/test/gps-freshness.spec.ts"
  },
  "keywords": [
    "retail",
    "fmcg",
    "shelf-monitoring",
    "planogram",
    "coca-cola",
    "telegram-bot",
    "supabase"
  ],
  "author": "oneTeam Core Team",
  "license": "UNLICENSED",
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "dotenv": "^16.4.7",
    "grammy": "^1.35.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.13.9",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.70.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
