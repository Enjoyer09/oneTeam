# =============================================================================
#  oneTeam — EditorConfig
# =============================================================================
#  WHY: without this, every developer's editor disagrees about indentation and
#  line endings, and every pull request turns into whitespace noise that hides
#  the one line that actually matters. Reviewers stop reading diffs closely —
#  which is how real bugs get approved.
# =============================================================================

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 100

# Markdown keeps trailing whitespace (it means a hard line break) and we do not
# reflow prose.
[*.md]
trim_trailing_whitespace = false
max_line_length = off

[*.{yml,yaml}]
indent_size = 2

[*.sql]
indent_size = 2

# Makefiles require literal tab indentation.
[Makefile]
indent_style = tab

[*.{json,jsonc}]
indent_size = 2
