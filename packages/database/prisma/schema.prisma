// oneTeam — Retail Execution Platform Database Schema (Prisma ORM)
// Domain: FMCG / Coca-Cola Distribution
// Modeled after Salesforce Consumer Goods Cloud & GoSpotCheck

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  ADMIN
  SUPERVISOR
  MERCHANDISER
  STORE_STAFF
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskState {
  DRAFT
  PUBLISHED
  DELIVERED
  ACKNOWLEDGED
  IN_PROGRESS
  SUBMITTED
  APPROVED
  REJECTED
}

model User {
  id              String         @id @default(uuid())
  email           String         @unique
  fullName        String         @map("full_name")
  role            UserRole       @default(MERCHANDISER)
  telegramChatId  String?        @unique @map("telegram_chat_id")
  phone           String?
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  storeTasks      StoreTask[]    @relation("AssignedUser")
  taskEvidences   TaskEvidence[] @relation("SubmittedEvidences")
  auditLogs       AuditLog[]     @relation("UserAuditLogs")

  @@map("users")
}

model Region {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  stores    Store[]

  @@map("regions")
}

model Store {
  id          String      @id @default(uuid())
  storeCode   String      @unique @map("store_code")
  name        String
  regionId    String      @map("region_id")
  chainName   String      @default("Bravo") @map("chain_name")
  storeFormat String      @default("supermarket") @map("store_format")
  address     String
  city        String      @default("Baku")
  latitude    Float
  longitude   Float
  isActive    Boolean     @default(true) @map("is_active")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  region      Region      @relation(fields: [regionId], references: [id])
  tasks       StoreTask[]

  @@index([storeCode])
  @@map("stores")
}

model Campaign {
  id          String   @id @default(uuid())
  name        String
  description String
  startDate   DateTime @map("start_date")
  endDate     DateTime @map("end_date")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  templates   TaskTemplate[]

  @@map("campaigns")
}

model TaskTemplate {
  id                       String       @id @default(uuid())
  campaignId               String?      @map("campaign_id")
  title                    String
  description              String
  referenceImageUrl        String       @map("reference_image_url")
  priority                 TaskPriority @default(MEDIUM)
  planogramRules           Json         @default("[]") @map("planogram_rules")
  requiresBeforeAfterPhoto Boolean      @default(false) @map("requires_before_after_photo")
  checklistSchema          Json         @default("[]") @map("checklist_schema")
  createdAt                DateTime     @default(now()) @map("created_at")
  updatedAt                DateTime     @updatedAt @map("updated_at")

  campaign                 Campaign?    @relation(fields: [campaignId], references: [id])
  storeTasks               StoreTask[]

  @@map("task_templates")
}

model StoreTask {
  id              String       @id @default(uuid())
  templateId      String       @map("template_id")
  storeId         String       @map("store_id")
  assignedUserId  String?      @map("assigned_user_id")
  status          TaskState    @default(DRAFT)
  deadline        DateTime
  publishedAt     DateTime?    @map("published_at")
  deliveredAt     DateTime?    @map("delivered_at")
  acknowledgedAt  DateTime?    @map("acknowledged_at")
  submittedAt     DateTime?    @map("submitted_at")
  reviewedAt      DateTime?    @map("reviewed_at")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  template        TaskTemplate @relation(fields: [templateId], references: [id])
  store           Store        @relation(fields: [storeId], references: [id])
  assignedUser    User?        @relation("AssignedUser", fields: [assignedUserId], references: [id])
  evidences       TaskEvidence[]

  @@index([status])
  @@index([storeId])
  @@map("store_tasks")
}

model TaskEvidence {
  id                 String    @id @default(uuid())
  storeTaskId        String    @map("store_task_id")
  submittedById      String    @map("submitted_by_id")
  photoUrl           String    @map("photo_url")
  photoType          String    @default("standard") @map("photo_type")
  checklistAnswers   Json      @default("[]") @map("checklist_answers")
  latitude           Float
  longitude          Float
  gpsDistanceMeters  Float     @map("gps_distance_meters")
  aiScore            Int?      @map("ai_score")
  aiDetections       Json      @default("[]") @map("ai_detections")
  aiSummary          String?   @map("ai_summary")
  reviewerFeedback   String?   @map("reviewer_feedback")
  submittedAt        DateTime  @default(now()) @map("submitted_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  storeTask          StoreTask @relation(fields: [storeTaskId], references: [id], onDelete: Cascade)
  submittedBy        User      @relation("SubmittedEvidences", fields: [submittedById], references: [id])

  @@index([storeTaskId])
  @@map("task_evidences")
}

model AuditLog {
  id         String   @id @default(uuid())
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  action     String
  fromState  String?  @map("from_state")
  toState    String?  @map("to_state")
  actorId    String?  @map("actor_id")
  payload    Json?
  createdAt  DateTime @default(now()) @map("created_at")

  actor      User?    @relation("UserAuditLogs", fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@map("audit_logs")
}
