# ==============================================================================
# oneTeam (Coca-Cola FMCG Platform) — Production Environment Template
# ==============================================================================
# Copy this file to .env.production and fill in real values before deployment:
# cp .env.production.example .env.production
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT
# ------------------------------------------------------------------------------
NODE_ENV=production
API_PORT=3001
WEB_PORT=80

# ------------------------------------------------------------------------------
# 2. POSTGRESQL DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# REQUIRED. There is no default: docker-compose.prod.yml refuses to start
# without it. Generate a strong one rather than inventing one:
#     openssl rand -base64 32
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=oneteam
POSTGRES_PORT=5432

# REQUIRED. Must point at the `postgres` service when using docker-compose, or
# at your managed database host when deploying to a platform.
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?sslmode=disable
# Or an external managed database (Railway, Supabase, Neon, AWS RDS):
# DATABASE_URL=postgresql://<user>:<password>@<host>:<port>/<database>

# ------------------------------------------------------------------------------
# 3. SUPABASE CLOUD BACKEND (Auth, Storage & Real-time Subscriptions)
# ------------------------------------------------------------------------------
# Retrieve from Supabase Dashboard -> Project Settings -> API:
SUPABASE_URL=https://your-production-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Storage Bucket Name for Shelf Photos and Audit Evidences:
SUPABASE_STORAGE_BUCKET=shelf-images

# ------------------------------------------------------------------------------
# 4. TELEGRAM BOT NOTIFICATION & FIELD MERCHANDISER BRIDGE
# ------------------------------------------------------------------------------
# Generated by @BotFather on Telegram:
TELEGRAM_BOT_TOKEN=

# REQUIRED. Telegram echoes this value back in the
# `X-Telegram-Bot-Api-Secret-Token` header on every webhook call, and the API
# compares it in constant time before trusting anything in the request body.
#
# Without it the API returns 503 and refuses every webhook — deliberately, so a
# misconfigured deployment cannot be driven by anyone who guesses the URL.
#
# Generate it, then register the same value with Telegram:
#     openssl rand -hex 32
#
#     curl -X POST "https://api.telegram.org/bot<TOKEN>/setWebhook" \
#          -d "url=https://<your-api-host>/api/notifications/telegram/webhook" \
#          -d "secret_token=<THE_VALUE_YOU_GENERATED>"
TELEGRAM_WEBHOOK_SECRET=

# Optional: Webhook URL for serverless production deployment (Railway/Cloud Run):
# TELEGRAM_WEBHOOK_URL=https://api.yourdomain.com/api/notifications/telegram/webhook

# ------------------------------------------------------------------------------
# 4b. CORS — WHO MAY CALL THE API FROM A BROWSER
# ------------------------------------------------------------------------------
# Comma-separated list of exact origins. No wildcards: `*` is rejected outright
# because the API uses bearer tokens, and a wildcard would let any web page a
# signed-in user visits call the API on their behalf.
#
# Leave empty in production and no browser origin will be allowed.
CORS_ALLOWED_ORIGINS=https://portal.yourdomain.com

# ------------------------------------------------------------------------------
# 5. SUPERVISOR WEB PORTAL (Vite / React SPA)
# ------------------------------------------------------------------------------
# IMPORTANT: these three are BUILD-time values, not runtime ones.
#
# Vite substitutes every VITE_* reference into the JavaScript bundle while it
# builds. Setting them on a running container changes nothing, because the
# values were already frozen into the files nginx serves. In
# docker-compose.prod.yml they are passed as `build.args`, which is the only
# place they take effect.
#
# Omit VITE_SUPABASE_URL and the portal falls back to its built-in demo data
# (see web/src/lib/supabase.ts) — it renders fine, but every store, task and
# audit you see is fake.
VITE_API_BASE_URL=https://api.yourdomain.com
VITE_SUPABASE_URL=https://your-production-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# 6. AI VISION & PLANOGRAM COMPLIANCE ENGINE
# ------------------------------------------------------------------------------
# Minimum confidence threshold for YOLOv8 FMCG bottle/can detection (0.0 to 1.0):
AI_VISION_CONFIDENCE_THRESHOLD=0.75

# Minimum score to trigger Instant 1-Click AI Approval (0 to 100%):
AUTO_APPROVE_COMPLIANCE_SCORE=90

# Anti-Fraud GPS Geofence threshold in meters (Blocks fake audits outside store):
GEOFENCE_RADIUS_METERS=100

# Push Notifications bridge (APNs mock mode for iOS devices):
MOCK_APNS_ENABLED=true
