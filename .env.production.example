# ==============================================================================
# oneTeam (Coca-Cola FMCG Platform) — Production Environment Template
# ==============================================================================
# Copy this file to .env.production and fill in real values before deployment:
# cp .env.production.example .env.production
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT
# ------------------------------------------------------------------------------
NODE_ENV=production
API_PORT=3001
WEB_PORT=80

# ------------------------------------------------------------------------------
# 2. POSTGRESQL DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# REQUIRED. There is no default: docker-compose.prod.yml refuses to start
# without it. Generate a strong one rather than inventing one:
#     openssl rand -base64 32
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=oneteam
POSTGRES_PORT=5432

# REQUIRED. Must point at the `postgres` service when using docker-compose, or
# at your managed database host when deploying to a platform.
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?sslmode=disable
# Or an external managed database (Railway, Supabase, Neon, AWS RDS):
# DATABASE_URL=postgresql://<user>:<password>@<host>:<port>/<database>

# ------------------------------------------------------------------------------
# 3. SUPABASE CLOUD BACKEND — NO LONGER USED
# ------------------------------------------------------------------------------
# Nothing reads these any more. The supervisor panel talks to the Core API, and
# so does the Telegram bot; the last Supabase client was deleted when the bot
# moved off it. Supabase was only ever PostgreSQL plus a wrapper, and the
# project runs on plain PostgreSQL 16 — on Railway's managed Postgres service,
# which is what gives it point-in-time recovery and HA.
#
# They are kept as a comment rather than removed so a deployment that still has
# them set is not mistaken for a working Supabase integration.
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=shelf-images

# ------------------------------------------------------------------------------
# 4. TELEGRAM BOT NOTIFICATION & FIELD MERCHANDISER BRIDGE
# ------------------------------------------------------------------------------
# Generated by @BotFather on Telegram:
TELEGRAM_BOT_TOKEN=

# Where the bot process finds the Core API.
#
# Use the private network, not the public hostname: the bot runs inside the same
# Railway project, and routing audit photos out to the internet and back for no
# reason is both slower and needlessly exposed.
ONETEAM_API_URL=http://api.railway.internal:3001

# The bot's service credential is now SIGNED, not a static string.
#
# REQUIRED (docker-compose.prod.yml refuses to start without it). The bot mints
# a short-lived, signed token for every request; the API verifies it with the
# same secret. Generate it:
#     openssl rand -hex 32
ONETEAM_SERVICE_SIGNING_SECRET=
# The user the bot acts as for its service calls. Prefer a dedicated service
# user over the seeded administrator; the bot derives the acting person per
# chat anyway.
ONETEAM_SERVICE_USER_ID=usr-admin-001

# REQUIRED for production (docker-compose.prod.yml). Turns the semi-public
# store code into a username and this into the password for device enrolment.
# Without it, anyone who learns a store code can enrol a device for that store.
#     openssl rand -hex 32
ONETEAM_ENROLLMENT_SECRET=

# Set to "1" when the API is reached ONLY through a reverse proxy (nginx,
# platform edge). The API then honours X-Forwarded-For so the per-address
# enrolment limiter sees real client addresses. Leave unset when the API port
# is directly reachable — a direct client could otherwise forge the header and
# rotate the limiter. docker-compose.prod.yml sets this on the api service.
ONETEAM_TRUST_PROXY=1

# REQUIRED. Telegram echoes this value back in the
# `X-Telegram-Bot-Api-Secret-Token` header on every webhook call, and the API
# compares it in constant time before trusting anything in the request body.
#
# Without it the API returns 503 and refuses every webhook — deliberately, so a
# misconfigured deployment cannot be driven by anyone who guesses the URL.
#
# Generate it, then register the same value with Telegram:
#     openssl rand -hex 32
#
#     curl -X POST "https://api.telegram.org/bot<TOKEN>/setWebhook" \
#          -d "url=https://<your-api-host>/api/notifications/telegram/webhook" \
#          -d "secret_token=<THE_VALUE_YOU_GENERATED>"
TELEGRAM_WEBHOOK_SECRET=

# Optional: Webhook URL for serverless production deployment (Railway/Cloud Run):
# TELEGRAM_WEBHOOK_URL=https://api.yourdomain.com/api/notifications/telegram/webhook

# ------------------------------------------------------------------------------
# 4b. CORS — WHO MAY CALL THE API FROM A BROWSER
# ------------------------------------------------------------------------------
# Comma-separated list of exact origins. No wildcards: `*` is rejected outright
# because the API uses bearer tokens, and a wildcard would let any web page a
# signed-in user visits call the API on their behalf.
#
# Leave empty in production and no browser origin will be allowed.
CORS_ALLOWED_ORIGINS=https://portal.yourdomain.com

# ------------------------------------------------------------------------------
# 5. SUPERVISOR WEB PORTAL (Vite / React SPA)
# ------------------------------------------------------------------------------
# IMPORTANT: these are BUILD-time values, not runtime ones.
#
# Vite substitutes every VITE_* reference into the JavaScript bundle while it
# builds. Setting them on a running container changes nothing, because the
# values were already frozen into the files nginx serves. In
# docker-compose.prod.yml they are passed as `build.args`, which is the only
# place they take effect.
#
# Leave VITE_API_BASE_URL empty for the normal deployment. The panel then calls
# /api/ on its own origin and nginx proxies it to the API, which means no
# rebuild is needed to move the API and — more importantly — no credential ends
# up in the bundle, because nginx attaches it at the edge.
VITE_API_BASE_URL=

# ------------------------------------------------------------------------------
# 6. SHELF-PHOTO ANALYSIS — TorchVision runtime is disabled without a model
# ------------------------------------------------------------------------------
# The vision worker uses TorchVision, but does not bundle weights. It stays
# disabled until a custom checkpoint and its provenance manifest are reviewed.
# COCO pretrained weights are only for explicit local prototyping; verify the
# weight/data terms before any commercial use. The repository currently has no
# labeled OneTeam SKU dataset and no production-ready checkpoint.
# ONETEAM_VISION_PROVIDER=off
# ONETEAM_TORCHVISION_MODE=disabled
# ONETEAM_TORCHVISION_CHECKPOINT=/models/reviewed/model.pth
# ONETEAM_TORCHVISION_WORKER_URL=
# ONETEAM_TORCHVISION_CONF=0.25
# REQUIRED when the vision worker is deployed: a shared bearer token. The
# worker refuses every /detect without it (503/401) and the bot must hold the
# same value. Generate with: openssl rand -hex 32
# ONETEAM_VISION_TOKEN=

# Anti-Fraud GPS Geofence threshold in meters (Blocks fake audits outside store):
GEOFENCE_RADIUS_METERS=100

# Push Notifications bridge (APNs mock mode for iOS devices):
MOCK_APNS_ENABLED=true
